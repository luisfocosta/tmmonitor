    {
        "id": "4cfd5172451f2adc",
        "type": "function",
        "z": "2477529e93aab871",
        "name": "case action",
        "func": "var msg2 = {};\nswitch (msg.payload.action) {\n    case \"play\": {\n        msg2.payload = \"/home/pi/scripts/stop_omxplayer.sh\";\n        msg2.comment = \"Stop any video playing.\";\n        node.send(msg2);\n        //Load the requested video on omxplayer\n        //node.warn ({Text: \"Playing video \" + msg.video});\n        msg2.payload = \"/usr/bin/omxplayer -b \" + msg.payload.video;\n        msg2.comment = \"Load video in omxplayer.\";\n        node.send(msg2);\n        //Play the requested video on omxplayer\n        msg2.payload = \"echo -n . >/tmp/cmd\";\n        msg2.comment = \"Play video loaded.\";\n        node.send(msg2);\n        global.set(\"lastplaytimestamp\", msg.payload.timestamp);\n\n        break;\n    }\n    case \"stop\":{\n        msg2.payload = \"pkill mxplayer\";\n        msg2.comment = \"Stop any video playing.\";\n        node.send(msg2);\n        break;\n    }\n    case \"pause\": {\n        msg2.payload = \"echo -n p >/tmp/cmd\";\n        msg2.comment = \"Pause video.\";\n        node.send(msg2);\n        break;\n    }\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
